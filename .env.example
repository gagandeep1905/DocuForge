# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=                  # server only (sb_secret_*); never expose to the browser
# Legacy fallback for existing deployments only:
# SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable sb_publishable_* key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=docuforge-uploads

# GitHub (optional, raises the API rate limit from 60/h to 5000/h)
GITHUB_TOKEN=

# Inngest (production only; not needed for the local dev server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
