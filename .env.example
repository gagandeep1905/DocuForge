# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=docuforge-uploads

# GitHub (optional, raises the API rate limit from 60/h to 5000/h)
GITHUB_TOKEN=

# Inngest (production only; not needed for the local dev server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
